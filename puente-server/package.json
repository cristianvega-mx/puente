{
  "name": "puente-server",
  "version": "0.2.0",
  "description": "MCP server that helps Spanish-speaking families understand and act on US school notices through Alexa+.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "smoke": "tsx scripts/smoke-test.ts",
    "typecheck": "tsc --noEmit",
    "bedrock-check": "tsx --env-file-if-exists=.env scripts/bedrock-check.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1142.0",
    "@modelcontextprotocol/client": "^2.1.0",
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.1.0",
    "@smithy/types": "^4.19.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
